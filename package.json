{
  "name": "cockpit-package-manager",
  "version": "0.1.1",
  "description": "Cockpit-based package manager using PackageKit",
  "license": "LGPL-2.1-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "typecheck": "tsc",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint ."
  },
  "devDependencies": {
    "@patternfly/patternfly": "6.7.0",
    "@patternfly/react-core": "6.7.0",
    "@patternfly/react-icons": "6.7.0",
    "@patternfly/react-table": "6.7.0",
    "@playwright/test": "^1.56.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/react-window": "^1.8.8",
    "@vitest/ui": "5.0.5",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "oxlint": "1.90.0"
  },
  "dependencies": {
    "react-window": "^2.2.2"
  },
  "engines": {
    "node": ">=24"
  }
}
